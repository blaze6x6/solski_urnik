# Povezava na PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Privzeti administrator (uporabi se samo ob prvem zagonu v prazni bazi)
ADMIN_EMAIL=admin@urnik.si
ADMIN_PASSWORD=urnik123

# SMTP za e-poštne povzetke urnika (neobvezno)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Samodejni dnevni povzetek: 1 = vklopljeno, ob uri DIGEST_TIME (HH:MM)
ENABLE_DIGEST=0
DIGEST_TIME=06:30

# Zaščita za ročni cron klic GET /api/cron/digest?secret=...
CRON_SECRET=

# Opomniki za dogodke (privzeto vklopljeni, ko je nastavljen SMTP_HOST)
ENABLE_REMINDERS=1
REMINDER_INTERVAL_MIN=5
